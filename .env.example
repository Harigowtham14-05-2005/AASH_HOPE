# Hugging Face Inference API Token
# Get your token from: https://huggingface.co/settings/tokens
# Make sure the token has read access to run inference.
HF_API_TOKEN=hf_your_hugging_face_token_here

# Supabase Configuration
# Go to your Supabase Dashboard -> Project Settings -> API
# Use the "Project URL" for SUPABASE_URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the "service_role" key for SUPABASE_SERVICE_KEY
# Note: Using the service_role key allows the service to upload files bypassing Row Level Security (RLS) policies.
# Keep this key extremely secure!
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# The name of the storage bucket created in your Supabase project (e.g., product-images)
# IMPORTANT: Create the bucket in the Supabase Storage dashboard and ensure it is configured as PUBLIC.
SUPABASE_BUCKET=product-images
